# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# Mayar Payment Gateway Configuration
MAYAR_API_KEY=your_mayar_api_key
MAYAR_API_URL=https://api.mayar.id/hl/v1

# Application Configuration
# NEXT_PUBLIC_APP_URL: Base URL of your application (required for payment redirect flow)
# - Development: http://localhost:3000
# - Production: https://yourdomain.com (must use HTTPS)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Cron Job Configuration
# Used to authenticate Vercel Cron and prevent unauthorized cron triggering.
# Generate a strong random value (e.g. `openssl rand -hex 32`) and set the
# same value in Vercel project env vars (Production scope).
CRON_SECRET=replace-me-with-random-32-byte-hex
